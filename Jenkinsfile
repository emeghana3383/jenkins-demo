pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                bat 'echo Building Application'
            }
        }

        stage('Test') {
            steps {
                bat 'echo Running Tests'
            }
        }

        stage('Package') {
            steps {
                bat 'echo Packaging Application'
            }
        }

        stage('Deploy') {
            steps {
                bat 'echo Deploying Application'
            }
        }
    }
}
